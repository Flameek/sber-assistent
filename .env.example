# Internal/offline mode: run Ollama or an OpenAI-compatible local server first.
KB_BACKEND=local
KB_DB=.local/handbook.sqlite
KB_DEMO_MODE=false
LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:1.5b
LLM_TIMEOUT=120
ALLOW_EXTERNAL_LLM=false
# External mode is optional. Set both LLM_PROVIDER=gigachat and ALLOW_EXTERNAL_LLM=true.
# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
